pipeline {
    agent any
    
    parameters {
        choice(
            name: 'ENVIRONMENT',
            choices: ['staging', 'production'],
            description: 'Environment de déploiement'
        )
        string(
            name: 'VERSION',
            defaultValue: 'latest',
            description: 'Version des images Docker à déployer'
        )
        booleanParam(
            name: 'SKIP_TESTS',
            defaultValue: false,
            description: 'Ignorer les tests de déploiement'
        )
    }
    
    environment {
        DOCKERHUB_USER = 'syrinaaa'
        COMPOSE_PROJECT_NAME = "learnhub-${params.ENVIRONMENT}"
    }
    
    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }
        
        stage('Pre-deployment Checks') {
            steps {
                script {
                    echo "🔍 Vérification de l'environnement ${params.ENVIRONMENT}"
                    
                    // Vérifier Docker
                    sh 'docker --version'
                    sh 'docker-compose --version'
                    
                    // Vérifier les images Docker
                    sh """
                        echo "Vérification des images Docker..."
                        docker pull ${DOCKERHUB_USER}/eureka-server:${params.VERSION}
                        docker pull ${DOCKERHUB_USER}/api-gateway:${params.VERSION}
                        docker pull ${DOCKERHUB_USER}/quiz-feedback-service:${params.VERSION}
                        docker pull ${DOCKERHUB_USER}/ai-service:${params.VERSION}
                    """
                }
            }
        }
        
        stage('Stop Existing Services') {
            steps {
                script {
                    echo "🛑 Arrêt des services existants..."
                    sh '''
                        docker-compose -p ${COMPOSE_PROJECT_NAME} down --remove-orphans || true
                        docker system prune -f --volumes || true
                    '''
                }
            }
        }
        
        stage('Deploy Services') {
            steps {
                script {
                    echo "🚀 Déploiement des services..."
                    
                    // Créer le fichier d'environnement
                    writeFile file: '.env', text: """
ENVIRONMENT=${params.ENVIRONMENT}
VERSION=${params.VERSION}
COMPOSE_PROJECT_NAME=${env.COMPOSE_PROJECT_NAME}
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=quiz_feedback_db
MYSQL_USER=quiz_user
MYSQL_PASSWORD=quiz_password
"""
                    
                    // Démarrer les services
                    sh '''
                        export COMPOSE_PROJECT_NAME=${COMPOSE_PROJECT_NAME}
                        docker-compose up -d
                    '''
                }
            }
        }
        
        stage('Health Check') {
            steps {
                script {
                    echo "🏥 Vérification de la santé des services..."
                    
                    def services = [
                        [name: 'Eureka Server', url: 'http://localhost:8761/actuator/health'],
                        [name: 'API Gateway', url: 'http://localhost:8888/actuator/health'],
                        [name: 'Quiz Feedback Service', url: 'http://localhost:8089/actuator/health'],
                        [name: 'AI Service', url: 'http://localhost:8090/actuator/health'],
                        [name: 'Frontend', url: 'http://localhost:80']
                    ]
                    
                    // Attendre un peu pour que les services démarrent
                    sleep(60)
                    
                    for (service in services) {
                        retry(10) {
                            sleep(10)
                            sh """
                                curl -f -s ${service.url} > /dev/null
                                echo "✅ ${service.name} is healthy"
                            """
                        }
                    }
                }
            }
        }
        
        stage('Deployment Tests') {
            when {
                not { params.SKIP_TESTS }
            }
            steps {
                script {
                    echo "🧪 Tests de déploiement..."
                    
                    // Test de base de l'API
                    sh '''
                        echo "Test de l'API Gateway..."
                        curl -f http://localhost:8888/actuator/health
                        
                        echo "Test du service Eureka..."
                        curl -f http://localhost:8761/
                        
                        echo "Test du frontend..."
                        curl -f http://localhost:80/
                    '''
                }
            }
        }
        
        stage('Deployment Summary') {
            steps {
                script {
                    echo """
🎉 DÉPLOIEMENT RÉUSSI!

📊 Environment: ${params.ENVIRONMENT}
🏷️  Version: ${params.VERSION}
🕒 Déployé le: ${new Date()}

📋 Services déployés:
  🔍 Eureka Server:      http://localhost:8761
  🌐 API Gateway:        http://localhost:8888
  📝 Quiz Service:       http://localhost:8089
  🤖 AI Service:         http://localhost:8090
  💻 Frontend:           http://localhost:80
  🗄️  MySQL:             localhost:3306

📊 Statut des conteneurs:
"""
                    sh 'docker-compose ps'
                }
            }
        }
    }
    
    post {
        success {
            echo '✅ Déploiement terminé avec succès!'
            // Ici tu peux ajouter des notifications (Slack, email, etc.)
        }
        failure {
            echo '❌ Échec du déploiement!'
            sh '''
                echo "Logs des services en échec:"
                docker-compose logs --tail=50
                
                echo "Nettoyage des services défaillants..."
                docker-compose down --remove-orphans
            '''
        }
        always {
            // Archiver les logs
            sh 'docker-compose logs > deployment-logs.txt || true'
            archiveArtifacts artifacts: 'deployment-logs.txt', allowEmptyArchive: true
        }
    }
}