// Jenkinsfile — Pipeline de déploiement Kubernetes
// Ce pipeline récupère les images déjà publiées sur Docker Hub
// et les déploie sur le cluster Kubernetes

pipeline {
    agent any
    
    environment {
        DOCKER_REGISTRY = 'docker.io/syrinaaa'
        KUBECONFIG = credentials('kubeconfig-credentials')
        NAMESPACE = 'learnhub'
        GITHUB_REPO = 'https://github.com/toumisyrine/quiz_.git'
        GITHUB_BRANCH = 'quiz-feedback_branch'
    }
    
    parameters {
        choice(
            name: 'ENVIRONMENT',
            choices: ['staging', 'production'],
            description: 'Environment de déploiement'
        )
        string(
            name: 'IMAGE_TAG',
            defaultValue: 'latest',
            description: 'Tag des images Docker à déployer'
        )
        booleanParam(
            name: 'SKIP_HEALTH_CHECK',
            defaultValue: false,
            description: 'Ignorer les tests de santé'
        )
    }
    
    stages {
        stage('1 — Checkout Manifests K8s') {
            steps {
                script {
                    echo "🔄 Récupération des manifests Kubernetes..."
                    // Récupérer les fichiers YAML de configuration Kubernetes
                    git branch: "${GITHUB_BRANCH}", 
                        url: "${GITHUB_REPO}",
                        credentialsId: 'github-credentials'
                    
                    echo '✅ Manifests Kubernetes récupérés'
                    
                    // Vérifier la structure des fichiers K8s
                    sh '''
                        echo "📂 Structure des manifests K8s:"
                        ls -la k8s/
                        echo "📋 Fichiers disponibles:"
                        find k8s/ -name "*.yaml" -o -name "*.yml"
                    '''
                }
            }
        }
        
        stage('2 — Vérifier disponibilité images Docker Hub') {
            steps {
                script {
                    echo "🐳 Vérification des images Docker Hub..."
                    
                    def services = [
                        'eureka-server',
                        'api-gateway', 
                        'quiz-feedback-service',
                        'ai-service',
                        'frontend'
                    ]
                    
                    services.each { service ->
                        try {
                            sh "docker pull ${DOCKER_REGISTRY}/${service}:${params.IMAGE_TAG}"
                            echo "✅ Image ${service}:${params.IMAGE_TAG} disponible"
                        } catch (Exception e) {
                            error "❌ Image ${service}:${params.IMAGE_TAG} non trouvée sur Docker Hub"
                        }
                    }
                    
                    echo '✅ Toutes les images sont disponibles sur Docker Hub'
                }
            }
        }
        
        stage('3 — Déploiement sur Kubernetes') {
            steps {
                script {
                    echo "☸️ Déploiement sur le cluster Kubernetes..."
                    
                    // Créer le namespace s'il n'existe pas
                    sh """
                        kubectl create namespace ${NAMESPACE} --dry-run=client -o yaml | kubectl apply -f -
                        echo "✅ Namespace ${NAMESPACE} créé/vérifié"
                    """
                    
                    // Appliquer TOUS les manifests du dossier k8s/
                    sh '''
                        echo "📦 Application des ConfigMaps et Secrets..."
                        kubectl apply -f k8s/namespace.yaml
                        kubectl apply -f k8s/configmap.yaml
                        
                        echo "🗄️ Déploiement de la base de données..."
                        kubectl apply -f k8s/mysql.yaml
                        
                        echo "🚀 Déploiement des microservices..."
                        kubectl apply -f k8s/eureka-server.yaml
                        kubectl apply -f k8s/api-gateway.yaml
                        kubectl apply -f k8s/quiz-feedback-service.yaml
                        kubectl apply -f k8s/ai-service.yaml
                        kubectl apply -f k8s/frontend.yaml
                        
                        echo "📊 Application du monitoring..."
                        kubectl apply -f k8s/monitoring/ || echo "⚠️ Monitoring non disponible"
                    '''
                    
                    echo '✅ Manifests appliqués sur le cluster K8s'
                }
            }
        }
        
        stage('4 — Attendre que les Pods soient prêts') {
            steps {
                script {
                    echo "⏳ Attente que les déploiements soient opérationnels..."
                    
                    // Attendre que MySQL soit prêt en premier
                    sh """
                        echo "🗄️ Attente de MySQL..."
                        kubectl rollout status deployment/mysql-deployment -n ${NAMESPACE} --timeout=180s
                    """
                    
                    // Attendre Eureka Server
                    sh """
                        echo "🔍 Attente d'Eureka Server..."
                        kubectl rollout status deployment/eureka-server -n ${NAMESPACE} --timeout=120s
                    """
                    
                    // Attendre les autres services
                    def services = [
                        'api-gateway',
                        'quiz-feedback-service', 
                        'ai-service',
                        'frontend'
                    ]
                    
                    services.each { service ->
                        sh """
                            echo "⏳ Attente de ${service}..."
                            kubectl rollout status deployment/${service} -n ${NAMESPACE} --timeout=120s
                        """
                    }
                    
                    echo '✅ Tous les déploiements sont opérationnels'
                }
            }
        }
        
        stage('5 — Test de santé') {
            when {
                not { params.SKIP_HEALTH_CHECK }
            }
            steps {
                script {
                    echo "🏥 Tests de santé des services..."
                    
                    // Afficher l'état du cluster
                    sh """
                        echo "📊 État des Pods:"
                        kubectl get pods -n ${NAMESPACE} -o wide
                        
                        echo "🌐 État des Services:"
                        kubectl get services -n ${NAMESPACE}
                        
                        echo "📈 État des HPA:"
                        kubectl get hpa -n ${NAMESPACE} || echo "Pas d'HPA configuré"
                        
                        echo "🔍 État des Ingress:"
                        kubectl get ingress -n ${NAMESPACE} || echo "Pas d'Ingress configuré"
                    """
                    
                    // Tests de santé des endpoints
                    sh '''
                        echo "🧪 Tests de santé des endpoints..."
                        
                        # Port-forward temporaire pour les tests
                        kubectl port-forward -n learnhub service/eureka-server-service 8761:8761 &
                        EUREKA_PID=$!
                        
                        kubectl port-forward -n learnhub service/api-gateway-service 8888:8888 &
                        GATEWAY_PID=$!
                        
                        kubectl port-forward -n learnhub service/frontend-service 8080:80 &
                        FRONTEND_PID=$!
                        
                        # Attendre que les port-forwards soient actifs
                        sleep 10
                        
                        # Tests
                        echo "🔍 Test Eureka Server..."
                        curl -f http://localhost:8761/actuator/health || echo "⚠️ Eureka non accessible"
                        
                        echo "🌐 Test API Gateway..."
                        curl -f http://localhost:8888/actuator/health || echo "⚠️ Gateway non accessible"
                        
                        echo "💻 Test Frontend..."
                        curl -f http://localhost:8080/ || echo "⚠️ Frontend non accessible"
                        
                        # Nettoyer les port-forwards
                        kill $EUREKA_PID $GATEWAY_PID $FRONTEND_PID || true
                    '''
                    
                    // Informations de connexion
                    sh '''
                        echo ""
                        echo "🎉 DÉPLOIEMENT TERMINÉ!"
                        echo "📋 Informations de connexion:"
                        
                        # Récupérer les IPs des nodes
                        NODE_IP=$(kubectl get nodes -o jsonpath='{.items[0].status.addresses[?(@.type=="ExternalIP")].address}')
                        if [ -z "$NODE_IP" ]; then
                            NODE_IP=$(kubectl get nodes -o jsonpath='{.items[0].status.addresses[?(@.type=="InternalIP")].address}')
                        fi
                        
                        echo "🌐 Node IP: $NODE_IP"
                        echo "🔍 Eureka Dashboard: http://$NODE_IP:30761 (si NodePort configuré)"
                        echo "🌐 API Gateway: http://$NODE_IP:30888 (si NodePort configuré)"
                        echo "💻 Frontend: http://$NODE_IP:30080 (si NodePort configuré)"
                        echo ""
                        echo "📊 Pour accéder aux services via port-forward:"
                        echo "kubectl port-forward -n learnhub service/eureka-server-service 8761:8761"
                        echo "kubectl port-forward -n learnhub service/api-gateway-service 8888:8888"
                        echo "kubectl port-forward -n learnhub service/frontend-service 8080:80"
                    '''
                }
            }
        }
        
        stage('6 — Vérification finale') {
            steps {
                script {
                    echo "🔍 Vérification finale du déploiement..."
                    
                    sh """
                        echo "📊 Résumé du déploiement:"
                        echo "Environment: ${params.ENVIRONMENT}"
                        echo "Image Tag: ${params.IMAGE_TAG}"
                        echo "Namespace: ${NAMESPACE}"
                        echo ""
                        
                        echo "📈 Métriques des ressources:"
                        kubectl top pods -n ${NAMESPACE} || echo "Metrics server non disponible"
                        
                        echo "🔄 Événements récents:"
                        kubectl get events -n ${NAMESPACE} --sort-by=.metadata.creationTimestamp | tail -10
                    """
                }
            }
        }
    }
    
    post {
        success {
            script {
                echo '🎉 Déploiement Kubernetes réussi !'
                
                // Notification de succès (optionnel)
                sh '''
                    echo "✅ SUCCÈS: Déploiement LearnHub terminé"
                    echo "📦 Environment: ''' + params.ENVIRONMENT + '''"
                    echo "🏷️ Version: ''' + params.IMAGE_TAG + '''"
                    echo "⏰ Déployé le: $(date)"
                '''
            }
        }
        failure {
            script {
                echo '❌ Échec du déploiement Kubernetes'
                
                sh """
                    echo "🔍 Diagnostic des erreurs:"
                    kubectl get events -n ${NAMESPACE} --sort-by=.metadata.creationTimestamp | tail -20
                    
                    echo "📊 État des Pods en échec:"
                    kubectl get pods -n ${NAMESPACE} | grep -v Running || true
                    
                    echo "📋 Logs des Pods en erreur:"
                    for pod in \$(kubectl get pods -n ${NAMESPACE} --field-selector=status.phase!=Running -o name 2>/dev/null); do
                        echo "--- Logs de \$pod ---"
                        kubectl logs \$pod -n ${NAMESPACE} --tail=20 || true
                    done
                """
            }
        }
        always {
            script {
                // Archiver les logs et informations de déploiement
                sh '''
                    echo "📋 Sauvegarde des informations de déploiement..."
                    kubectl get all -n learnhub > deployment-status.txt
                    kubectl describe pods -n learnhub > pods-description.txt
                    kubectl get events -n learnhub > events.txt
                '''
                
                archiveArtifacts artifacts: '*.txt', allowEmptyArchive: true
                
                echo "🧹 Nettoyage des images Docker locales..."
                sh 'docker system prune -f || true'
            }
        }
    }
}