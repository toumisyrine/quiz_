pipeline {
    agent any
    
    environment {
        DOCKER_REGISTRY = 'docker.io/syrinaaa'
        KUBECONFIG = '/var/lib/jenkins/.kube/config'
        NAMESPACE = 'learnhub'
    }
    
    stages {
        stage('1 — Checkout Manifests K8s') {
            steps {
                echo '📥 Récupération des manifests Kubernetes...'
                checkout scm
                sh 'ls -la k8s-deploy.yaml'
                echo '✅ Manifests Kubernetes récupérés'
            }
        }
        
        stage('2 — Vérifier disponibilité images Docker Hub') {
            steps {
                echo '🔍 Vérification des images sur Docker Hub...'
                sh 'docker pull syrinaaa/eureka-server:latest'
                sh 'docker pull syrinaaa/api-gateway:latest'
                sh 'docker pull syrinaaa/quiz-feedback-service:latest'
                sh 'docker pull syrinaaa/ai-service:latest'
                echo '✅ Toutes les images sont disponibles sur Docker Hub'
            }
        }
        
        stage('3 — Apply K8s') {
            steps {
                echo '☸️ Déploiement sur Kubernetes...'
                script {
                    try {
                        // Vérifier la connexion Kubernetes
                        sh 'kubectl cluster-info'
                        sh 'kubectl get nodes'
                        
                        // Vérifier le fichier YAML
                        sh 'kubectl apply --dry-run=client -f k8s-deploy.yaml'
                        
                        // Créer le namespace s'il n'existe pas
                        sh 'kubectl create namespace learnhub --dry-run=client -o yaml | kubectl apply -f -'
                        
                        // Appliquer les manifests
                        sh 'kubectl apply -f k8s-deploy.yaml'
                        echo '✅ Manifests appliqués avec succès'
                        
                    } catch (Exception e) {
                        echo "❌ Erreur lors du déploiement: ${e.getMessage()}"
                        echo "🔍 Vérification de l'état de Kubernetes:"
                        sh 'kubectl cluster-info || echo "Pas de connexion K8s"'
                        sh 'kubectl get nodes || echo "Pas de nodes disponibles"'
                        throw e
                    }
                }
            }
        }
        
        stage('4 — Vérifier Pods') {
            steps {
                echo '⏳ Attente du démarrage des pods...'
                sh "kubectl get pods -n ${NAMESPACE}"
                sh "kubectl wait --for=condition=ready pod -l app=eureka-server -n ${NAMESPACE} --timeout=300s || echo 'Eureka pas encore prêt'"
                sh "kubectl wait --for=condition=ready pod -l app=api-gateway -n ${NAMESPACE} --timeout=300s || echo 'Gateway pas encore prêt'"
                sh "kubectl wait --for=condition=ready pod -l app=quiz-feedback-service -n ${NAMESPACE} --timeout=300s || echo 'Quiz service pas encore prêt'"
                sh "kubectl wait --for=condition=ready pod -l app=ai-service -n ${NAMESPACE} --timeout=300s || echo 'AI service pas encore prêt'"
                echo '✅ Vérification des pods terminée'
            }
        }
        
        stage('5 — Smoke Test') {
            steps {
                echo '🏥 Tests de santé des services...'
                script {
                    try {
                        sh """
                            echo "🌐 URLs des services:"
                            echo "Eureka: http://\$(minikube ip):\$(kubectl get svc eureka-service -n ${NAMESPACE} -o jsonpath='{.spec.ports[0].nodePort}')"
                            echo "Gateway: http://\$(minikube ip):\$(kubectl get svc api-gateway-service -n ${NAMESPACE} -o jsonpath='{.spec.ports[0].nodePort}')"
                        """
                        
                        // Test simple de connectivité
                        sh "kubectl get all -n ${NAMESPACE}"
                        echo '✅ Services déployés et accessibles'
                        
                    } catch (Exception e) {
                        echo "⚠️ Certains tests ont échoué: ${e.getMessage()}"
                    }
                }
            }
        }
    }
    
    post {
        success {
            echo '🎉 DÉPLOIEMENT KUBERNETES RÉUSSI!'
            echo '📊 Vérifiez avec: kubectl get all -n learnhub'
            echo '🌐 Accédez aux services via les NodePorts de Minikube'
        }
        failure {
            echo '❌ DÉPLOIEMENT ÉCHOUÉ!'
            echo '🔍 Vérifiez: kubectl get pods -n learnhub'
            echo '📋 Logs: kubectl logs -n learnhub <pod-name>'
        }
    }
}
