    agent any
    
    tools {
        jdk 'jdk17'
    }
    
    environment {
        DOCKERHUB_USER = 'syrinaaa'
        DOCKER_CREDENTIALS = 'dockerhub-credentials'
        SERVICE_NAME = 'eureka-server'
        SERVICE_PORT = '8761'
        IMAGE_TAG = "${BUILD_NUMBER}"
    }
    
    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }
        
        stage('Build Service') {
            steps {
                dir('backend/eureka-server') {
                    sh 'java -version'
                    sh 'mvn -version'
                    sh 'ls -la'
                    sh 'mvn clean package -DskipTests=true'
                    sh 'ls -la target/'
                }
            }
        }
        
        stage('Run Tests') {
            steps {
                dir('backend/eureka-server') {
                    script {
                        try {
                            sh 'mvn test'
                        } catch (Exception e) {
                            echo "Tests failed: ${e.getMessage()}"
                            echo "Continuing with build..."
                        }
                    }
                }
            }
        }
        
        stage('Build & Push Docker Image') {
            steps {
                dir('backend/eureka-server') {
                    script {
                        // Login to Docker Hub
                        withCredentials([usernamePassword(credentialsId: DOCKER_CREDENTIALS, usernameVariable: 'DOCKER_USER', passwordVariable: 'DOCKER_PASS')]) {
                            sh 'echo $DOCKER_PASS | docker login -u $DOCKER_USER --password-stdin'
                        }
                        
                        // Build and push images
                        sh "docker build -t ${DOCKERHUB_USER}/${SERVICE_NAME}:${IMAGE_TAG} ."
                        sh "docker push ${DOCKERHUB_USER}/${SERVICE_NAME}:${IMAGE_TAG}"
                        sh "docker build -t ${DOCKERHUB_USER}/${SERVICE_NAME}:latest ."
                        sh "docker push ${DOCKERHUB_USER}/${SERVICE_NAME}:latest"
                        
                        // Logout
                        sh 'docker logout'
                    }
                }
            }
        }
        
        stage('Cleanup') {
            steps {
                sh "docker rmi ${DOCKERHUB_USER}/${SERVICE_NAME}:${IMAGE_TAG} || true"
                sh "docker rmi ${DOCKERHUB_USER}/${SERVICE_NAME}:latest || true"
            }
        }
    }
    
    post {
        success {
            echo "✅ ${SERVICE_NAME} pipeline réussi!"
            echo "📦 Image Docker créée: ${DOCKERHUB_USER}/${SERVICE_NAME}:${IMAGE_TAG}"
            echo "🌐 Service disponible sur port: ${SERVICE_PORT}"
        }
        failure {
            echo "❌ ${SERVICE_NAME} pipeline échoué!"
        }
        always {
            cleanWs()
        }
    }
}