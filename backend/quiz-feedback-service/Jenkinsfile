pipeline {
    agent any
    
    tools {
        jdk 'jdk17'
    }
    
    environment {
        DOCKERHUB_USER = 'syrinaaa'
        DOCKER_CREDENTIALS = 'dockerhub-credentials'
        SERVICE_NAME = 'quiz-feedback-service'
        SERVICE_PORT = '8089'
        IMAGE_TAG = "${BUILD_NUMBER}"
    }
    
    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }
        
        stage('Build Service') {
            steps {
                dir('backend/quiz-feedback-service') {
                    sh 'java -version'
                    sh 'mvn -version'
                    sh 'ls -la'
                    sh 'mvn clean package -DskipTests=true'
                    sh 'ls -la target/'
                }
            }
        }
        
        stage('Run Tests') {
            steps {
                dir('backend/quiz-feedback-service') {
                    script {
                        try {
                            sh 'mvn test'
                        } catch (Exception e) {
                            echo "Tests failed: ${e.getMessage()}"
                            echo "Continuing with build..."
                        }
                    }
                }
            }
        }
        
        stage('SonarQube Analysis') {
            steps {
                dir('backend/quiz-feedback-service') {
                    script {
                        try {
                            withSonarQubeEnv('SonarQube') {
                                sh '''
                                    mvn sonar:sonar \
                                      -Dsonar.projectKey=quiz-feedback-service \
                                      -Dsonar.projectName="Quiz Feedback Service" \
                                      -Dsonar.host.url=$SONAR_HOST_URL \
                                      -Dsonar.login=$SONAR_AUTH_TOKEN
                                '''
                            }
                            echo '✅ SonarQube analysis completed'
                        } catch (Exception e) {
                            echo "⚠️ SonarQube analysis failed: ${e.getMessage()}"
                            echo "Continuing with build..."
                        }
                    }
                }
            }
        }
        
        stage('Quality Gate') {
            steps {
                script {
                    try {
                        timeout(time: 5, unit: 'MINUTES') {
                            def qg = waitForQualityGate()
                            if (qg.status != 'OK') {
                                echo "⚠️ Quality Gate failed: ${qg.status}"
                                echo "Continuing with build despite quality gate failure..."
                            } else {
                                echo '✅ Quality Gate passed'
                            }
                        }
                    } catch (Exception e) {
                        echo "⚠️ Quality Gate check failed: ${e.getMessage()}"
                        echo "Continuing with build..."
                    }
                }
            }
        }
        
        stage('Build & Push Docker Image') {
            steps {
                dir('backend/quiz-feedback-service') {
                    script {
                        // Login to Docker Hub
                        withCredentials([usernamePassword(credentialsId: DOCKER_CREDENTIALS, usernameVariable: 'DOCKER_USER', passwordVariable: 'DOCKER_PASS')]) {
                            sh 'echo $DOCKER_PASS | docker login -u $DOCKER_USER --password-stdin'
                        }
                        
                        // Build images only (no push for testing)
                        sh "docker build -t ${DOCKERHUB_USER}/${SERVICE_NAME}:${IMAGE_TAG} ."
                        echo "✅ Docker image built successfully: ${DOCKERHUB_USER}/${SERVICE_NAME}:${IMAGE_TAG}"
                        
                        // Try to push with better error handling
                        try {
                            sh "docker push ${DOCKERHUB_USER}/${SERVICE_NAME}:${IMAGE_TAG}"
                            sh "docker tag ${DOCKERHUB_USER}/${SERVICE_NAME}:${IMAGE_TAG} ${DOCKERHUB_USER}/${SERVICE_NAME}:latest"
                            sh "docker push ${DOCKERHUB_USER}/${SERVICE_NAME}:latest"
                            echo "✅ Images pushed successfully to Docker Hub"
                        } catch (Exception e) {
                            echo "⚠️ Docker push failed: ${e.getMessage()}"
                            echo "🔧 Please check Docker Hub credentials and repository permissions"
                            echo "📦 Docker image built locally: ${DOCKERHUB_USER}/${SERVICE_NAME}:${IMAGE_TAG}"
                        }
                        
                        // Logout
                        sh 'docker logout'
                    }
                }
            }
        }
        
        stage('Cleanup') {
            steps {
                sh "docker rmi ${DOCKERHUB_USER}/${SERVICE_NAME}:${IMAGE_TAG} || true"
                sh "docker rmi ${DOCKERHUB_USER}/${SERVICE_NAME}:latest || true"
            }
        }
    }
    
    post {
        success {
            echo "✅ ${SERVICE_NAME} pipeline réussi!"
            echo "📦 Image Docker créée: ${DOCKERHUB_USER}/${SERVICE_NAME}:${IMAGE_TAG}"
            echo "🌐 Service disponible sur port: ${SERVICE_PORT}"
        }
        failure {
            echo "❌ ${SERVICE_NAME} pipeline échoué!"
        }
        always {
            cleanWs()
        }
    }
}