pipeline {
    agent any
    
    environment {
        DOCKERHUB_USER = 'syrinaaa'
        DOCKER_CREDENTIALS = 'dockerhub-credentials'
    }
    
    stages {
        stage('Test Docker Hub Connection') {
            steps {
                script {
                    echo "🔧 Testing Docker Hub credentials..."
                    
                    withCredentials([usernamePassword(credentialsId: DOCKER_CREDENTIALS, usernameVariable: 'DOCKER_USER', passwordVariable: 'DOCKER_PASS')]) {
                        sh '''
                            echo "Username: $DOCKER_USER"
                            echo "Password length: ${#DOCKER_PASS}"
                            echo "Testing Docker Hub login..."
                            echo $DOCKER_PASS | docker login -u $DOCKER_USER --password-stdin
                        '''
                    }
                    
                    echo "✅ Docker Hub login successful!"
                    
                    // Test simple push
                    sh '''
                        echo "Testing simple push..."
                        docker pull hello-world
                        docker tag hello-world syrinaaa/test-image:latest
                        docker push syrinaaa/test-image:latest
                        echo "✅ Push test successful!"
                    '''
                    
                    sh 'docker logout'
                }
            }
        }
    }
    
    post {
        always {
            sh 'docker rmi syrinaaa/test-image:latest || true'
            sh 'docker rmi hello-world || true'
        }
    }
}