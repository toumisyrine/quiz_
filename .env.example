# Configuration d'environnement pour LearnHub
# Copier ce fichier vers .env et modifier les valeurs

# Environment
ENVIRONMENT=production
VERSION=latest
COMPOSE_PROJECT_NAME=learnhub-production

# Database Configuration
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=quiz_feedback_db
MYSQL_USER=quiz_user
MYSQL_PASSWORD=quiz_password

# AI Service Configuration
OPENAI_API_KEY=your-openai-api-key-here

# Spring Profiles
SPRING_PROFILES_ACTIVE=docker

# Eureka Configuration
EUREKA_CLIENT_SERVICE_URL_DEFAULTZONE=http://eureka-server:8761/eureka/

# Logging
LOGGING_LEVEL_ROOT=INFO
LOGGING_LEVEL_COM_ELEARNING=DEBUG