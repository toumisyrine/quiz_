pipeline {
    agent any
    
    tools {
        jdk 'jdk17'
        maven 'maven'
    }
    
    environment {
        SERVICE_NAME = 'eureka-server'
        SONAR_PROJECT_KEY = 'eureka-server-test'
        SONAR_PROJECT_NAME = 'Eureka Server Test'
    }
    
    stages {
        stage('Checkout') {
            steps {
                echo '📥 Récupération du code source...'
                checkout scm
                sh 'ls -la backend/eureka-server/'
            }
        }
        
        stage('Build & Test') {
            steps {
                dir('backend/eureka-server') {
                    echo '🔨 Build et tests du service...'
                    sh 'java -version'
                    sh 'mvn -version'
                    sh 'mvn clean compile test -DskipTests=false'
                    echo '✅ Build et tests terminés'
                }
            }
        }
        
        stage('SonarQube Analysis') {
            steps {
                dir('backend/eureka-server') {
                    echo '🔍 Analyse SonarQube en cours...'
                    script {
                        try {
                            // Test avec SonarQube configuré
                            withSonarQubeEnv('SonarQube') {
                                sh '''
                                    mvn sonar:sonar \
                                      -Dsonar.projectKey=${SONAR_PROJECT_KEY} \
                                      -Dsonar.projectName="${SONAR_PROJECT_NAME}" \
                                      -Dsonar.host.url=$SONAR_HOST_URL \
                                      -Dsonar.login=$SONAR_AUTH_TOKEN \
                                      -Dsonar.java.coveragePlugin=jacoco \
                                      -Dsonar.coverage.jacoco.xmlReportPaths=target/site/jacoco/jacoco.xml
                                '''
                            }
                            echo '✅ Analyse SonarQube réussie'
                        } catch (Exception e) {
                            echo "⚠️ Analyse SonarQube avec configuration: ${e.getMessage()}"
                            echo "🔧 Test avec paramètres manuels..."
                            
                            // Test avec paramètres manuels (si SonarQube pas encore configuré)
                            sh '''
                                mvn sonar:sonar \
                                  -Dsonar.projectKey=${SONAR_PROJECT_KEY} \
                                  -Dsonar.projectName="${SONAR_PROJECT_NAME}" \
                                  -Dsonar.host.url=http://localhost:9000 \
                                  -Dsonar.login=admin \
                                  -Dsonar.password=admin \
                                  -Dsonar.java.coveragePlugin=jacoco || echo "SonarQube non disponible, continuons..."
                            '''
                        }
                    }
                }
            }
        }
        
        stage('Quality Gate') {
            steps {
                script {
                    try {
                        echo '🚪 Vérification Quality Gate...'
                        timeout(time: 5, unit: 'MINUTES') {
                            def qg = waitForQualityGate()
                            if (qg.status != 'OK') {
                                echo "⚠️ Quality Gate Status: ${qg.status}"
                                echo "📊 Détails disponibles dans SonarQube Dashboard"
                            } else {
                                echo '✅ Quality Gate: PASSED'
                            }
                        }
                    } catch (Exception e) {
                        echo "⚠️ Quality Gate non disponible: ${e.getMessage()}"
                        echo "🔧 Vérifiez la configuration SonarQube dans Jenkins"
                    }
                }
            }
        }
        
        stage('SonarQube Report') {
            steps {
                echo '📊 Génération du rapport SonarQube...'
                script {
                    try {
                        echo "🌐 SonarQube Dashboard: http://localhost:9000/dashboard?id=${SONAR_PROJECT_KEY}"
                        echo "📈 Métriques disponibles:"
                        echo "  • Code Coverage"
                        echo "  • Code Smells"
                        echo "  • Bugs"
                        echo "  • Security Hotspots"
                        echo "  • Duplications"
                    } catch (Exception e) {
                        echo "Rapport non disponible: ${e.getMessage()}"
                    }
                }
            }
        }
    }
    
    post {
        success {
            echo '🎉 ANALYSE SONARQUBE RÉUSSIE!'
            echo "📊 Consultez les résultats: http://localhost:9000/dashboard?id=${SONAR_PROJECT_KEY}"
            echo "🔍 Service analysé: ${SERVICE_NAME}"
        }
        failure {
            echo '❌ ANALYSE SONARQUBE ÉCHOUÉE!'
            echo '🔧 Vérifications à faire:'
            echo '  1. SonarQube est-il démarré? (docker-compose up -d sonarqube)'
            echo '  2. Jenkins SonarQube plugin installé?'
            echo '  3. Configuration SonarQube dans Jenkins?'
        }
        always {
            echo '📋 Nettoyage...'
            cleanWs()
        }
    }
}